{"$schema":"https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/schemas/sarif-schema-2.1.0.json","runs":[{"artifacts":[{"length":123,"location":{"uri":"input.usdz"}}],"invocations":[{"executionSuccessful":true}],"properties":{"acceptedIncomplete":false,"configuration":{"budgets":{"archiveBytes":104857600,"fileBytes":26214400,"fileCount":1000,"textureBytes":20971520,"textureMaxDimension":4096,"totalTextureBytes":83886080},"externalCheck":"disabled","gatePolicy":{"allowIncomplete":false,"failOn":"error"},"includeSensitiveDetails":false,"profile":"general-v1","safetyEnvelopeVersion":2},"counts":{"byCategory":{"appleCompatibility":0,"archiveSpecification":0,"policy":1,"validatorLimitation":1},"bySeverity":{"error":1,"note":0,"warning":1}},"coverage":{"areas":{"appleAdvice":{"reasons":[],"requested":false,"state":"notRun"},"byteBudgets":{"reasons":[],"requested":true,"state":"complete"},"containerStructure":{"reasons":[],"requested":true,"state":"complete"},"entrySafety":{"reasons":[],"requested":true,"state":"complete"},"references":{"reasons":[{"location":{"entryName":"root.usdc"},"reasonID":"invalidHeader","ruleID":"UVK-USD-001"},{"location":{"entryName":"root.usdc"},"reasonID":"binaryReferences","ruleID":"UVK-LIM-002"}],"requested":true,"state":"partial"},"textureDimensions":{"reasons":[],"requested":true,"state":"complete"}},"isComplete":false},"exitCode":1,"gateDecision":"fail","input":{"byteSize":123,"displayName":"input.usdz"},"operationalErrors":[],"provenance":{"kind":"native","validatorVersion":"0.2.0"},"validationStatus":"failed"},"results":[{"level":"error","locations":[{"logicalLocations":[{"fullyQualifiedName":"root.usdc"}],"physicalLocation":{"artifactLocation":{"uri":"input.usdz"}}}],"message":{"text":"The inspected binary USD structure is malformed."},"partialFingerprints":{"uvkOccurrence/v1":"79e3c4eaa7bcad2c793319a4de88e2ef1dcf0801c406117f4be8362cebdea175"},"properties":{"category":"policy","evidence":{"reason":"invalidHeader"},"provenance":{"kind":"native","validatorVersion":"0.2.0"}},"ruleId":"UVK-USD-001"},{"level":"warning","locations":[{"logicalLocations":[{"fullyQualifiedName":"root.usdc"}],"physicalLocation":{"artifactLocation":{"uri":"input.usdz"}}}],"message":{"text":"Native reference inspection is unavailable for this binary USD layer."},"partialFingerprints":{"uvkOccurrence/v1":"f1420107c1bf874ec4456ed615bd343fa8ee7d6dcf7da00bca2e7e8bec70c062"},"properties":{"category":"validatorLimitation","evidence":{"reason":"binaryReferences"},"provenance":{"kind":"native","validatorVersion":"0.2.0"}},"ruleId":"UVK-LIM-002"}],"tool":{"driver":{"name":"usdz-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Established malformed/truncated ZIP record or invalid field range."},"id":"UVK-ARC-001","properties":{"applicability":"ZIP records whose required bytes or field ranges can be checked within the safety envelope. Unsupported features use a limitation when malformedness is not established.","category":"archiveSpecification","family":"container","rationale":"A container cannot be trusted when required records are malformed or truncated."},"shortDescription":{"text":"Malformed ZIP record"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Contradictory local/directory records, overlapping ownership, or unindexed members."},"id":"UVK-ARC-002","properties":{"applicability":"Supported classic single-disk ZIP records after bounded metadata reads. Skip downstream checks whose ownership cannot be established.","category":"archiveSpecification","family":"container","rationale":"Directory and local records must describe consistent, nonoverlapping ownership of the package bytes."},"shortDescription":{"text":"Contradictory ZIP ownership"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Stored payload CRC mismatch."},"id":"UVK-ARC-003","properties":{"applicability":"Safely indexed stored regular payloads that can be read completely within the safety envelope. Skip unsupported or unavailable payloads.","category":"archiveSpecification","family":"container","rationale":"The recorded CRC must match the encoded stored payload."},"shortDescription":{"text":"Stored payload CRC mismatch"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Nonzero compression method or unequal stored/uncompressed sizes."},"id":"UVK-ARC-004","properties":{"applicability":"Entries with established method and size fields, including zero/zero stored entries. Reject nonempty/zero claims before payload interpretation.","category":"archiveSpecification","family":"container","rationale":"The supported USDZ container uses stored payloads with equal encoded and uncompressed sizes."},"shortDescription":{"text":"Entry is not stored one-to-one"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Encrypted entry."},"id":"UVK-ARC-005","properties":{"applicability":"Entries whose ZIP encryption flags can be read conclusively.","category":"archiveSpecification","family":"container","rationale":"Encrypted entries are outside the permitted USDZ stored-container form."},"shortDescription":{"text":"Encrypted entry"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Regular-file payload is not 64-byte aligned."},"id":"UVK-ARC-006","properties":{"applicability":"Regular entries with safely established physical payload offsets; directory entries have no payload-alignment obligation.","category":"archiveSpecification","family":"container","rationale":"USDZ regular-file payloads require 64-byte alignment."},"shortDescription":{"text":"Unaligned regular payload"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Obvious USD suffix/signature mismatch."},"id":"UVK-ARC-007","properties":{"applicability":"USD members with enough safely readable signature bytes for a conclusive mismatch. Insufficient bytes do not establish a mismatch.","category":"archiveSpecification","family":"container","rationale":"A USD filename must not contradict its recognizable text or binary signature."},"shortDescription":{"text":"USD suffix and signature disagree"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Archive byte budget exceeded."},"id":"UVK-BUD-001","properties":{"applicability":"Known input byte size with archiveBytes enabled; warn only when observed bytes exceed the threshold.","category":"policy","family":"budgets","rationale":"Encoded archive bytes are a configurable project delivery budget, separate from hard safety limits."},"shortDescription":{"text":"Archive byte budget exceeded"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Per-file encoded-byte budget exceeded."},"id":"UVK-BUD-002","properties":{"applicability":"Safely indexed regular entries with fileBytes enabled; warn only when encoded bytes exceed the threshold.","category":"policy","family":"budgets","rationale":"A per-file encoded-byte warning identifies large package members without decoding them."},"shortDescription":{"text":"File byte budget exceeded"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Regular-file-count budget exceeded."},"id":"UVK-BUD-003","properties":{"applicability":"Established regular-entry count with fileCount enabled; warn only when the count exceeds the threshold.","category":"policy","family":"budgets","rationale":"Regular-file count is a configurable delivery-complexity budget; directories do not count."},"shortDescription":{"text":"File count budget exceeded"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Per-texture encoded-byte budget exceeded."},"id":"UVK-BUD-004","properties":{"applicability":"Recognized texture members with textureBytes enabled and established stored sizes; warn only above the threshold.","category":"policy","family":"budgets","rationale":"Encoded texture bytes measure delivery cost without decoding pixels."},"shortDescription":{"text":"Texture byte budget exceeded"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Total encoded texture-byte budget exceeded."},"id":"UVK-BUD-005","properties":{"applicability":"Safely indexed recognized textures with totalTextureBytes enabled; warn only when their encoded-byte sum exceeds the threshold.","category":"policy","family":"budgets","rationale":"Aggregate encoded texture bytes are a project budget independent of decoded memory cost."},"shortDescription":{"text":"Total texture byte budget exceeded"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Supported texture width or height exceeds the dimension budget."},"id":"UVK-BUD-006","properties":{"applicability":"textureMaxDimension enabled and conclusive dimensions from a supported PNG/JPEG header within the scan boundary; warn only above the threshold.","category":"policy","family":"budgets","rationale":"Width or height is advisory delivery policy; no pixel decoding or decoded-memory estimate is performed."},"shortDescription":{"text":"Texture dimension budget exceeded"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Conclusively malformed supported texture header."},"id":"UVK-BUD-007","properties":{"applicability":"Supported PNG/JPEG headers with enough readable bytes to establish malformedness during an enabled dimension check.","category":"policy","family":"budgets","rationale":"Conclusive malformedness is a policy error; unavailable or unsupported dimensions instead produce an explicit limitation when requested."},"shortDescription":{"text":"Malformed texture header"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Unsupported ZIP feature, layout, encoding, or type semantics."},"id":"UVK-LIM-001","properties":{"applicability":"ZIP64, data descriptors, unsupported layouts, encodings, or type semantics where supported inspection cannot continue conclusively.","category":"validatorLimitation","family":"container","rationale":"A processing boundary makes affected native coverage incomplete; it must not turn established malformed records into mere limitations."},"shortDescription":{"text":"Unsupported ZIP semantics"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Binary USD reference inspection unavailable."},"id":"UVK-LIM-002","properties":{"applicability":"Recognized binary USD layers whose package-local reference inspection remains wholly unavailable.","category":"validatorLimitation","family":"references","rationale":"Recognizing a binary signature does not prove complete USD reference validation."},"shortDescription":{"text":"Binary references not inspected"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Expression/template/package identifier cannot be resolved natively."},"id":"UVK-LIM-003","properties":{"applicability":"Recognized asset expressions, templates, or package identifiers outside the supported literal path subset.","category":"validatorLimitation","family":"references","rationale":"The validator does not evaluate expressions, composition, or nested package identifiers and cannot infer their targets."},"shortDescription":{"text":"Unsupported asset identifier"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Recognized USD text cannot be scanned in its supported encoding."},"id":"UVK-LIM-004","properties":{"applicability":"Recognized text USD whose encoding is outside the supported bounded USDA scanner.","category":"validatorLimitation","family":"references","rationale":"Unscannable recognized text leaves reference coverage incomplete without inventing missing-reference findings."},"shortDescription":{"text":"USD text encoding not scanned"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Requested texture dimensions unavailable within the supported boundary."},"id":"UVK-LIM-005","properties":{"applicability":"textureMaxDimension enabled; unsupported formats, unsupported header variants, or no conclusive dimensions within the 1 MiB header scan boundary.","category":"validatorLimitation","family":"budgets","rationale":"Dimension coverage must be explicit when bounded PNG/JPEG inspection cannot provide a result; the scan boundary alone is not a hard safety error."},"shortDescription":{"text":"Texture dimensions unavailable"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Nested package content not inspected."},"id":"UVK-LIM-006","properties":{"applicability":"Recognized nested .usdz members after safe container indexing; no recursive package inspection.","category":"validatorLimitation","family":"container","rationale":"The native engine does not extract or recursively inspect nested packages, so affected coverage remains incomplete."},"shortDescription":{"text":"Nested package not inspected"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Binary USD reference inspection is incomplete."},"id":"UVK-LIM-007","properties":{"applicability":"Recognized binary USD layers with partially inspected references or an unsupported or ambiguous representation.","category":"validatorLimitation","family":"references","rationale":"A bounded USDC reader must disclose uninspected dependencies without treating unsupported representations as established corruption."},"shortDescription":{"text":"Binary reference inspection partial"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Unsafe/invalid archive member name."},"id":"UVK-PATH-001","properties":{"applicability":"Raw archive member names available from safely bounded metadata; retain exact bytes for identity even when display is redacted.","category":"policy","family":"references","rationale":"Package names must remain safe package-relative identifiers without host-filesystem resolution."},"shortDescription":{"text":"Unsafe archive member name"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Duplicate name or file/directory namespace conflict."},"id":"UVK-PATH-002","properties":{"applicability":"Safely indexed member names compared by exact case-sensitive UTF-8 bytes without Unicode normalization.","category":"policy","family":"references","rationale":"A package namespace must not ambiguously assign a name to multiple entries or incompatible file/directory ownership."},"shortDescription":{"text":"Conflicting package namespace"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Symlink or prohibited non-regular member."},"id":"UVK-PATH-003","properties":{"applicability":"Members whose supported ZIP attributes conclusively establish a prohibited type; unknown type semantics use a limitation.","category":"policy","family":"references","rationale":"Package references must not depend on symlinks or prohibited special filesystem objects."},"shortDescription":{"text":"Prohibited member type"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Absolute/external/unsafe literal asset path."},"id":"UVK-PATH-004","properties":{"applicability":"Conclusive asset values from supported USDA scanning or USDC inspection; absolute and external values are redacted by default.","category":"policy","family":"references","rationale":"Standalone package references must not access external resources or unsafe host paths."},"shortDescription":{"text":"Unsafe literal asset path"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Reference normalization escapes package root."},"id":"UVK-PATH-005","properties":{"applicability":"Supported package-relative literal paths normalized against the containing layer; skip when safe layer identity is unavailable.","category":"policy","family":"references","rationale":"Lexical reference resolution must remain within the package root."},"shortDescription":{"text":"Reference escapes package root"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Supported literal path has no regular package target."},"id":"UVK-PATH-006","properties":{"applicability":"Supported safely normalized literals and a trustworthy package index; skip when a container failure makes target existence unknowable.","category":"policy","family":"references","rationale":"A supported package-local dependency must resolve to a regular package entry using exact UTF-8 identity."},"shortDescription":{"text":"Missing regular package target"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Conclusively malformed supported asset literal."},"id":"UVK-PATH-007","properties":{"applicability":"The supported USDA asset-literal subset when scanning conclusively establishes malformedness; unsupported expressions use a limitation.","category":"policy","family":"references","rationale":"Malformed supported syntax is an error without claiming complete USD grammar validation."},"shortDescription":{"text":"Malformed supported asset literal"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"First regular entry fails the standalone default-layer policy."},"id":"UVK-POL-001","properties":{"applicability":"A safely established first regular entry; skip when container ownership prevents determining entry order.","category":"policy","family":"container","rationale":"This project requires the first regular entry to be a standalone USD default layer; it does not impose a universal single-layer requirement."},"shortDescription":{"text":"Default layer policy failed"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Member outside the v0.1 suffix catalogue."},"id":"UVK-POL-002","properties":{"applicability":"Safely indexed members classified by the case-insensitive v0.1 suffix catalogue.","category":"policy","family":"container","rationale":"The frozen member catalogue is project policy, not a universal claim about every future USDZ extension."},"shortDescription":{"text":"Member suffix outside policy"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Hard safety/processing ceiling exceeded, including findings truncation."},"id":"UVK-RES-001","properties":{"applicability":"Any fixed safety-envelope ceiling; reserve the final finding slot when discovery is truncated and stop affected work.","category":"policy","rationale":"Hard resource limits protect bounded native processing, mark affected coverage incomplete, and remain blocking even when incomplete coverage is accepted."},"shortDescription":{"text":"Hard processing ceiling exceeded"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Conclusively malformed inspected binary USD structure."},"id":"UVK-USD-001","properties":{"applicability":"Supported USDC structures whose inspected bytes conclusively establish corruption; affected reference coverage remains partial.","category":"policy","family":"references","rationale":"Established binary corruption is a blocking policy error; unsupported or ambiguous representations instead produce a limitation."},"shortDescription":{"text":"Malformed binary USD structure"}}],"version":"0.2.0"}}}],"version":"2.1.0"}
